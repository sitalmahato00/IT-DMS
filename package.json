{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "it-dms",
    "description": "IT Department Management System (IT-DMS)",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "deploy:prepare": "mkdir -p storage/framework/sessions storage/framework/views storage/framework/cache/data bootstrap/cache && chmod -R 775 storage bootstrap/cache && php artisan config:clear && php artisan cache:clear && php artisan config:cache"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.10",
        "chart.js": "^4.5.1",
        "jquery": "^3.7.1",
        "nepali-date-picker": "^2.0.2"
    }
}
