# Production Environment Configuration for Railway
# Copy these settings to Railway dashboard at: Web Service → Variables tab

# ============================================================================
# APPLICATION CORE
# ============================================================================
APP_NAME="IT-DMS"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE_USE_GENERATE_COMMAND
APP_DEBUG=false
APP_URL=https://your-domain.up.railway.app
APP_LOG_LEVEL=warning

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ============================================================================
# DATABASE - Railway MySQL
# ============================================================================
DB_CONNECTION=mysql
DB_HOST=${{ MySQL.MYSQL_HOST }}
DB_PORT=${{ MySQL.MYSQL_PORT }}
DB_DATABASE=${{ MySQL.MYSQL_DATABASE }}
DB_USERNAME=${{ MySQL.MYSQL_USER }}
DB_PASSWORD=${{ MySQL.MYSQL_PASSWORD }}

# Optional: PostgreSQL instead of MySQL
# DB_CONNECTION=pgsql
# DB_HOST=${{ PostgreSQL.POSTGRES_HOST }}
# DB_PORT=${{ PostgreSQL.POSTGRES_PORT }}
# DB_DATABASE=${{ PostgreSQL.POSTGRES_DB }}
# DB_USERNAME=${{ PostgreSQL.POSTGRES_USER }}
# DB_PASSWORD=${{ PostgreSQL.POSTGRES_PASSWORD }}

# ============================================================================
# SESSION & COOKIES
# ============================================================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIES=true
SESSION_ENCRYPT=false

# ============================================================================
# CACHE - Phase 1 (File-based)
# ============================================================================
CACHE_STORE=file
CACHE_DRIVER=file

# For Phase 2: Switch to Redis
# CACHE_STORE=redis
# CACHE_DRIVER=redis
# REDIS_HOST=${{ Redis.REDIS_HOST }}
# REDIS_PORT=${{ Redis.REDIS_PORT }}
# REDIS_PASSWORD=${{ Redis.REDIS_PASSWORD }}

# ============================================================================
# QUEUE - Phase 1 (Database)
# ============================================================================
QUEUE_CONNECTION=database

# For Phase 1+: Switch to Redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=${{ Redis.REDIS_HOST }}
# REDIS_PORT=${{ Redis.REDIS_PORT }}
# REDIS_PASSWORD=${{ Redis.REDIS_PASSWORD }}

# ============================================================================
# BROADCAST
# ============================================================================
BROADCAST_CONNECTION=log
BROADCAST_DRIVER=log

# ============================================================================
# FILESYSTEM
# ============================================================================
FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local

# For future: S3 storage for uploads
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your_bucket

# ============================================================================
# MAIL - SMTP Configuration
# ============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=hellogoog94@gmail.com
MAIL_PASSWORD="zezy bhrs kiif qaln"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hellogoog94@gmail.com
MAIL_FROM_NAME="IT Department Management System"

# ============================================================================
# SECURITY
# ============================================================================
BCRYPT_ROUNDS=12

# ============================================================================
# MAINTENANCE MODE
# ============================================================================
APP_MAINTENANCE_DRIVER=file

# ============================================================================
# LOGGING
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ============================================================================
# NOTES FOR RAILWAY DEPLOYMENT
# ============================================================================
# 1. Generate APP_KEY locally:
#    php artisan key:generate --show
#    Copy the output and paste into Railway APP_KEY variable
#
# 2. Database credentials:
#    Use the ${{ MySQL.MYSQL_* }} variables from Railway
#    These auto-populate when Railway MySQL service is added
#
# 3. Testing the connection:
#    php artisan tinker
#    >>> DB::connection()->getPdo()
#
# 4. For Phase 2 upgrades:
#    - Add Redis service: Click "+ Add Service" → Select Redis
#    - Update CACHE_STORE, SESSION_DRIVER, QUEUE_CONNECTION
#    - Redeploy
#
# 5. Sensitive credentials:
#    - Never commit .env file to git
#    - Always use Railway Variables tab for secrets
#    - Keep database passwords secure
#
# ============================================================================
