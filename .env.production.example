#######################################
# IT-DMS PRODUCTION ENVIRONMENT FILE #
#######################################
# Copy this to .env on production server
# and update values for your environment

# APPLICATION
APP_NAME="IT-DMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com

# APP KEY - GENERATE WITH: php artisan key:generate
APP_KEY=base64:YOUR_BASE64_ENCODED_KEY_HERE

# LOCALIZATION
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# MAINTENANCE
APP_MAINTENANCE_DRIVER=file

###########################
# DATABASE CONFIGURATION
###########################
DB_CONNECTION=mysql
DB_HOST=your-database-host.com
DB_PORT=3306
DB_DATABASE=it_dms_prod
DB_USERNAME=db_user_prod
DB_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Optional: MySQL SSL Certificate Path
# DB_SSLCA=/path/to/ca.pem
# DB_SSLCERT=/path/to/cert.pem
# DB_SSLKEY=/path/to/key.pem
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

###########################
# SESSION CONFIGURATION
###########################
SESSION_DRIVER=redis
SESSION_LIFETIME=480           # 8 hours
SESSION_ENCRYPT=true           # MUST BE TRUE FOR PRODUCTION
SESSION_SECURE_COOKIE=true      # Set to true if using HTTPS
SESSION_HTTP_ONLY=true          # Prevent JS access to cookies
SESSION_SAME_SITE=lax           # CSRF protection

###########################
# CACHE CONFIGURATION
###########################
CACHE_DRIVER=redis
CACHE_STORE=redis
PUBLIC_DATA_CACHE_TTL=600           # 10 minutes
DEPARTMENT_CACHE_TTL=1800           # 30 minutes

###########################
# QUEUE CONFIGURATION
###########################
QUEUE_CONNECTION=redis
QUEUE_FAILED_TABLE=failed_jobs

###########################
# REDIS CONFIGURATION
###########################
REDIS_HOST=your-redis-host.com
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

###########################
# MAIL CONFIGURATION
###########################
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

###########################
# LOG CONFIGURATION
###########################
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_STACK=daily             # Daily rotating logs
LOG_DAILY_DAYS=30           # Keep 30 days of logs

###########################
# FILESYSTEM CONFIGURATION
###########################
FILESYSTEM_DISK=local
PUBLIC_PATH=/public         # Ensure storage symlink created

###########################
# BROADCAST CONFIGURATION
###########################
BROADCAST_DRIVER=log

###########################
# BCRYPT ROUNDS
###########################
BCRYPT_ROUNDS=12            # Recommended for production

###########################
# SENTRY ERROR TRACKING (Optional but recommended)
###########################
# SENTRY_LARAVEL_DSN=https://your-key@o.ingest.sentry.io/your-id
# SENTRY_TRACE_SAMPLE_RATE=0.1

###########################
# SECURITY HEADERS
###########################
SECURE_HEADERS_ENABLED=true
SECURE_HEADERS_ADD_HSTS=true
SECURE_HEADERS_HSTS_MAX_AGE=31536000
SECURE_HEADERS_ADD_CONTENT_SECURITY_POLICY=true

###########################
# CORS CONFIGURATION
###########################
ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

###########################
# RATE LIMITING
###########################
THROTTLE_REQUESTS=60
THROTTLE_REQUESTS_PER_MINUTE=1   # For API endpoints

###########################
# OPTIONAL: AWS S3 FOR FILE STORAGE
###########################
# AWS_ACCESS_KEY_ID=your-key
# AWS_SECRET_ACCESS_KEY=your-secret
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket-name
# AWS_URL=https://your-bucket-name.s3.amazonaws.com
# FILESYSTEM_DISK=s3

###########################
# DEPLOYMENT NOTES
###########################
# 1. GENERATE APP_KEY: php artisan key:generate
# 2. Run migrations: php artisan migrate --force
# 3. Create storage link: php artisan storage:link
# 4. Cache config: php artisan config:cache
# 5. Cache routes: php artisan route:cache
# 6. Cache views: php artisan view:cache
# 7. Test deployment: curl https://yourdomain.com/health
